#!/usr/bin/env bash
# Runs the browser-script unit tests with Node's built-in test runner.
# No npm, no packages: only `node` (22+, for glob support in --test) on PATH is needed.
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v node >/dev/null 2>&1; then
    echo "bin/test-js: node is not on PATH (Node 22+ required for node --test)." >&2
    exit 1
fi
major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$major" -lt 22 ]; then
    echo "bin/test-js: Node 22+ is required (found $(node -v)); node --test globs need it." >&2
    exit 1
fi
exec node --test "tests/js/**/*.test.mjs"
