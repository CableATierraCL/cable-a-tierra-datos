{
    "name": "cableatierra/cable-a-tierra-datos",
    "description": "Cable a Tierra data band: NoFires fire-risk summaries for the home page.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "brain/monkey": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "CableATierra\\Datos\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.29"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
